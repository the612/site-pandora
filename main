comite:()=>ban('Le Comité d’Éthique','Composition, mandat et pouvoirs')+
`<h2>Mandat</h2><p>Le Comité d’Éthique est une instance autonome, impartiale et indépendante de tout département. Il évalue, suspend ou interrompt toute expérience, procédure de confinement ou opération contraire à l’éthique.</p>
<h2>Gouvernance</h2><div class="box"><p><b>Président :</b> Kaito Arima, en liaison avec le Conseil O5 et le Cabinet de l’Administrateur.</p><p><b>Représentante du Sous-Comité Anomalies Sapientes :</b> Léon Sierra.</p><p><b>Unité d’intervention :</b> FIM Oméga-1 (« La Main Gauche »), placée sous la juridiction exclusive du Comité.</p></div>
<h2>Compétences</h2><ol><li>Primauté sur le Code Pénal interne en matière d’infractions éthiques.</li><li>Accès prioritaire aux rapports, dossiers médicaux, serveurs et zones classifiées.</li><li>Traitement des signalements, y compris anonymes, avec protection des lanceurs d’alerte.</li><li>Amendement du Code, adopté à l’unanimité du Conseil Éthique.</li></ol>`,
code:()=>ban('Code d’éthique unifié','Charte déontologique — En vigueur')+
`<div class="sb"><input id="q" type="search" aria-label="Rechercher" placeholder="Rechercher dans tout le code (ex. A.S.I.A., Classe-D, lockdown)"><p class="m" id="cnt"></p></div><div class="toc">${D.map((d,i)=>`<button data-d="${i+1}" title="${d.t}">Division ${R[i]}</button>`).join('')}</div><div id="cb"></div>`,
suggestion:()=>ban('Proposer une amélioration','Toute contribution est examinée par le Comité')+
`<h2>Registre des décisions</h2><p class="m">Nouvelle : reçue. En étude : examen en cours. Retenue : retenue pour amendement. Acceptée : intégrée au Code. Rejetée : non retenue.</p><div class="reg" id="rg"></div><div id="dl"></div><div class="orn"><i></i></div><h2>Soumettre une suggestion</h2><div id="f"><label for="n">Nom ou matricule (facultatif)</label><input id="n" maxlength="80">
<label for="a">Article concerné</label><select id="a"><option>Général</option>${arts().map(x=>`<option>${x}</option>`).join('')}</select>
<label for="t">Suggestion</label><textarea id="t" rows="7" maxlength="2000"></textarea>
<button class="p" id="go">Transmettre</button><p id="ok"></p></div>`,
admin:()=>{if(sessionStorage.getItem('ce-adm')!=='1')return ban('Espace administrateur','Accès restreint')+`<label for="pw">Code d’accès</label><input id="pw" type="password"><button class="p" id="lg">Se connecter</button><p id="er"></p>`;
const L=load();return ban('Espace administrateur','Suggestions reçues')+`<p class="m">${L.length} suggestion(s) enregistrée(s) sur cet appareil.</p>`+(L.length?L.map((s,i)=>`<div class="s"><div class="m">${esc(s.d)} — ${esc(s.n||'Anonyme')} — ${esc(s.a)}</div><p>${esc(s.t)}</p><select data-i="${i}">${Object.keys(SC).map(o=>`<option${o===s.s?' selected':''}>${o}</option>`).join('')}</select><button data-x="${i}">Supprimer</button><input class="mi" data-m="${i}" placeholder="Motif de la décision (affiché dans le registre public)" value="${esc(s.m||'')}"></div>`).join(''):'<p>Aucune suggestion pour le moment.</p>')+`<button class="p" id="lo">Se déconnecter</button>`}};
function rx(q){const m={a:'aàâä',e:'eéèêë',i:'iîï',o:'oôö',u:'uùûü',c:'cç'};
const p=q.toLowerCase().replace(/[^a-z0-9àâäéèêëîïôöùûüç\s]/g,'').trim();if(!p)return null;
return new RegExp(p.split(/\s+/).map(w=>[...w].map(c=>{const k=c.normalize('NFD')[0];return m[k]?'['+m[k]+']':k}).join('\\.?')).join('[\\s\\-]+'),'gi')}
const hl=(s,r)=>s.split(/(<[^>]+>)/).map(x=>x[0]==='<'?x:x.replace(r,'<mark>$&</mark>')).join('');
function codeHTML(q){const r=rx(q);let n=0;
const h=D.map((d,i)=>{const as=d.a.filter(([a,t,it])=>!r||(a+' '+t+' '+it.join(' ')).replace(/<[^>]+>/g,'').search(r)>=0);
if(!as.length)return'';
return `<section id="d${i+1}"><div class="band rv"><small>Division ${R[i]}</small><h2>${d.t}</h2></div>`+as.map(([a,t,it])=>{n++;const H=s=>r?hl(s,r):s;return `<div class="art rv"><h3>Article ${a} — ${H(t)}</h3>`+(it.length?`<ol>${it.map(x=>`<li>${H(x)}</li>`).join('')}</ol>`:'<p class="m">Texte de l’article en cours d’intégration.</p>')+'</div>'}).join('')+'</section>'}).join('');
return{h:h||'<p>Aucun résultat.</p>',n}}
const SC={'Nouvelle':'#6b7a70','En étude':'#a67c37','Retenue':'#2f6f8f','Acceptée':'#2f7a4f','Rejetée':'#9b3b32'};
const IC={'Nouvelle':'<path d="M3 6h18v12H3zM3 6l9 7 9-7"/>','En étude':'<path d="M6 3h12M6 21h12M7 3c0 5 5 6 5 9s-5 4-5 9M17 3c0 5-5 6-5 9s5 4 5 9"/>','Retenue':'<path d="M6 3h12v18l-6-4-6 4z"/>','Acceptée':'<circle cx="12" cy="12" r="9"/><path d="M8 12.5l3 3 5-6"/>','Rejetée':'<circle cx="12" cy="12" r="9"/><path d="M9 9l6 6M15 9l-6 6"/>'};
function reg(f){const L=load();
$('#rg').innerHTML=Object.keys(SC).map(k=>`<button class="st${f===k?' on':''}" style="--c:${SC[k]}" data-f="${k}"><b>${L.filter(s=>s.s===k).length}</b><span>${k}</span></button>`).join('');
const sh=L.filter(s=>!f||s.s===f);
$('#dl').innerHTML=sh.length?sh.map(s=>`<div class="dec" style="--c:${SC[s.s]}"><svg viewBox="0 0 24 24">${IC[s.s]}</svg><div><span class="tag">${s.s}</span><div class="m">${esc(s.d)} — ${esc(s.a)}</div><p>${esc(s.t.length>160?s.t.slice(0,160)+'…':s.t)}</p>${s.m?`<div class="mot">${esc(s.m)}</div>`:''}</div></div>`).join(''):'<div class="box"><p>Aucune suggestion dans cette catégorie pour le moment.</p></div>';
document.querySelectorAll('[data-f]').forEach(b=>b.onclick=()=>reg(f===b.dataset.f?'':b.dataset.f))}
const io=new IntersectionObserver(e=>e.forEach(x=>{if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target)}}),{threshold:.08});
const rv=()=>document.querySelectorAll('.rv:not(.in)').forEach(e=>io.observe(e));
function route(){const h=(location.hash||'#accueil').slice(1);let v=h;
const m=/^div-(\d+)$/.exec(h);
app.innerHTML=(m?V.code:V[h]||V.accueil)();
if(m)v='code';
document.querySelectorAll('nav a').forEach(a=>a.classList.toggle('on',a.dataset.v===v));
menu(false);window.scrollTo(0,0);bind()}
function bind(){
const g=$('#go');if(g)g.onclick=()=>{const t=$('#t').value.trim();if(t.length<10){$('#ok').textContent='Veuillez détailler votre suggestion.';return}
const L=load();L.unshift({n:$('#n').value.trim(),a:$('#a').value,t,s:'Nouvelle',d:new Date().toLocaleDateString('fr-FR')});save(L);$('#f').innerHTML='<div class="box"><p>Votre suggestion a été transmise au Comité d’Éthique.</p></div>';reg('')};
const l=$('#lg');if(l)l.onclick=()=>{if($('#pw').value==='ethis-admin'){sessionStorage.setItem('ce-adm','1');route()}else $('#er').textContent='Code incorrect.'};
const o=$('#lo');if(o)o.onclick=()=>{sessionStorage.removeItem('ce-adm');route()};
document.querySelectorAll('.s select').forEach(s=>s.onchange=()=>{const L=load();L[s.dataset.i].s=s.value;save(L)});
document.querySelectorAll('[data-x]').forEach(b=>b.onclick=()=>{const L=load();L.splice(b.dataset.x,1);save(L);route()});
document.querySelectorAll('[data-m]').forEach(i=>i.onchange=()=>{const L=load();L[i.dataset.m].m=i.value.trim();save(L)});
if($('#rg'))reg('');
const q=$('#q');if(q){const up=()=>{const c=codeHTML(q.value);$('#cb').innerHTML=c.h;$('#cnt').textContent=q.value.trim()?c.n+' article(s) correspondant(s)':'';rv()};q.oninput=up;up();
document.querySelectorAll('[data-d]').forEach(b=>b.onclick=()=>{const e=$('#d'+b.dataset.d);if(e)e.scrollIntoView({behavior:'smooth'})});
const m=/^div-(\d+)$/.exec(location.hash.slice(1));if(m)setTimeout(()=>{const e=$('#d'+m[1]);if(e)e.scrollIntoView()},50)}
rv()}
function menu(o){$('#nv').classList.toggle('o',o);$('#sh').classList.toggle('o',o)}
$('#bg').onclick=()=>menu(!$('#nv').classList.contains('o'));
$('#sh').onclick=()=>menu(false);
addEventListener('hashchange',route);route();
</script>
